{
  "name": "gradpulse-desktop",
  "private": true,
  "version": "1.0.0",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix ../web run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build:web": "npm --prefix ../web run build && node copy-web-dist.cjs",
    "build": "npm run build:web && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "ec.edu.uce.gradpulse",
    "productName": "GradPulse",
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer-dist/**"
    ]
  }
}